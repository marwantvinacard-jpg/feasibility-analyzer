rules_version = '2';

// FeasibilityAI Firestore security rules.
// Principles:
//  - A user reads only their own user doc, analyses and reports.
//  - Clients can NEVER create analyses, set their own status/role/credits, or
//    read anyone's stored API key. Those are server-only (Admin SDK bypasses
//    rules) after checking approval + credits.
//  - Admin = a custom claim (request.auth.token.admin == true), set server-side.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function userChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // True when usernames/{name} points at the caller once this write (or the
    // transaction it's part of) lands — getAfter sees the claim made alongside it.
    function ownsUsername(name) {
      return name is string
        && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid;
    }
    function validTermsAcceptance() {
      return request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion.size() <= 20;
    }
    function isOrgMember(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // --- users ---
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // A new signup may create ONLY their own doc, pending, as a normal user,
      // with exactly the fields newUserDoc() writes — no orgId, stripeCustomerId,
      // subscriptionStatus or anything else the server relies on.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['email', 'name', 'status', 'role', 'credits', 'keyMode', 'createdAt', 'username', 'termsAcceptedAt', 'termsVersion'])
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user'
        && request.resource.data.credits == 0
        && request.resource.data.keyMode == 'platform'
        // The profile email must be the account's real (Auth) email — so nobody
        // shows up on the admin screen as someone else.
        && request.resource.data.email == request.auth.token.email
        && (!('username' in request.resource.data) || ownsUsername(request.resource.data.username))
        && (!('termsAcceptedAt' in request.resource.data) || validTermsAcceptance());

      // Users may change ONLY their own preferences. Everything else — status,
      // role, credits, orgId, stripeCustomerId, subscriptionStatus, email — is
      // written by the server (Admin SDK) or an admin. An allowlist, not a
      // denylist, so a field added server-side later is protected by default.
      allow update: if isOwner(uid)
        && userChangedKeys().hasOnly(
             ['keyMode', 'language', 'trainingOptOut', 'lastSeenAt', 'firstSeenAt', 'username', 'name',
              'termsAcceptedAt', 'termsVersion'])
        && (!userChangedKeys().hasAny(['keyMode'])
            || request.resource.data.keyMode in ['platform', 'byok'])
        && (!userChangedKeys().hasAny(['language'])
            || request.resource.data.language in ['en', 'ar', 'fr'])
        && (!userChangedKeys().hasAny(['trainingOptOut'])
            || request.resource.data.trainingOptOut is bool)
        && (!userChangedKeys().hasAny(['lastSeenAt'])
            || request.resource.data.lastSeenAt == request.time)
        && (!userChangedKeys().hasAny(['firstSeenAt'])
            || request.resource.data.firstSeenAt == request.time)
        // username + display name are set once, at signup, together with the
        // usernames/{name} claim in the same transaction.
        && (!userChangedKeys().hasAny(['username', 'name'])
            || (!('username' in resource.data)
                && ownsUsername(request.resource.data.username)
                && request.resource.data.name is string
                && request.resource.data.name.size() <= 100))
        // Terms acceptance is recorded once (at signup), with the server's time.
        && (!userChangedKeys().hasAny(['termsAcceptedAt', 'termsVersion'])
            || (!('termsAcceptedAt' in resource.data) && validTermsAcceptance()));

      // Approvals, role changes and credit grants are admin-only.
      allow update, delete: if isAdmin();

      // Encrypted BYOK keys live in a server-only subcollection — no client access.
      match /secrets/{doc} {
        allow read, write: if false; // Admin SDK only
      }
    }

    // --- usernames: username -> { uid } only. Readable so signup can check a
    // name is free. Emails are no longer stored here (anyone could read them);
    // username login/reset happens server-side. Docs from before that change
    // still hold an email, so those stay unreadable until migrated. ---
    match /usernames/{username} {
      allow get: if resource == null || !('email' in resource.data);
      allow list: if false; // no enumeration
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update, delete: if false; // immutable from the client (Admin SDK can override)
    }

    // --- analyses (created + written by the server worker only) ---
    match /analyses/{analysisId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid) ||
        (signedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId));
      allow create, update, delete: if false; // server (Admin SDK) only

      match /stageOutputs/{stage} {
        allow read: if isAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/analyses/$(analysisId)).data.uid == request.auth.uid);
        allow write: if false;
      }

      // Named stress-test scenarios — owner/admin read, server-only write.
      match /scenarios/{scenarioId} {
        allow read: if isAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/analyses/$(analysisId)).data.uid == request.auth.uid);
        allow write: if false; // server (Admin SDK) only, via /api/scenarios
      }
    }

    // --- organizations: multi-tenant workspace layer, additive on top of the
    // per-user model above. Owner manages branding/keys server-side; any
    // member can read the org doc and the member roster.
    match /organizations/{orgId} {
      allow read: if isAdmin() || isOrgMember(orgId);
      allow write: if false; // server only, via /api/org routes

      match /members/{uid} {
        allow read: if isAdmin() || isOrgMember(orgId);
        allow write: if false; // server only
      }

      // API key metadata (never the raw secret) — owner-only, server-written.
      match /apiKeys/{keyId} {
        allow read: if isAdmin() || isOrgMember(orgId);
        allow write: if false; // server only, via /api/org/keys
      }

      // The org's shared, encrypted LLM API key — server-only, no client access.
      match /secrets/{doc} {
        allow read, write: if false; // Admin SDK only
      }
    }

    // --- pending org invites — server only, via /api/org/invites and /api/org/members.
    // Membership starts only when the invitee accepts. ---
    match /orgInvites/{inviteId} {
      allow read, write: if false;
    }

    // --- shared rate-limit counters — server only (lib/rateLimit.ts) ---
    match /rateLimits/{doc} {
      allow read, write: if false;
    }

    // --- reports ---
    match /reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // server only
    }

    // --- usage ledger (read own, server writes) ---
    match /usage/{uid}/{document=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // --- payment history (Stripe webhook writes; owner + admin read) ---
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // server only, via the Stripe webhook
    }

    // --- admin audit log — admin-only read, server-only write ---
    match /auditLog/{entry} {
      allow read: if isAdmin();
      allow write: if false; // server only, via lib/firebase/audit.ts
    }

    // --- raw LLM prompt/completion pairs, captured for a future fine-tune —
    // admin-only read (this is training data, not user-facing), server-only write.
    match /trainingData/{entry} {
      allow read: if isAdmin();
      allow write: if false; // server only, via lib/engine/trainingLog.ts
    }

    // --- Stripe webhook idempotency ledger — no client access at all, not even admin. ---
    match /processedStripeEvents/{eventId} {
      allow read, write: if false; // server only, via app/api/stripe/webhook
    }

    // --- server-side error log — admin-only read, server-only write. ---
    match /errorLog/{entry} {
      allow read: if isAdmin();
      allow write: if false; // server only, via lib/firebase/errorLog.ts
    }
  }
}
