rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{uid} {
      // Owner and admins can read profiles.
      allow read: if isOwner(uid) || isAdmin();

      // Clients may NOT create/write profiles directly — profiles are created by
      // the Auth onCreate Cloud Function / backend (Admin SDK bypasses rules).
      // Owners may only update their own displayName; never status/role/keys/counters.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName']);
      allow create, delete: if false;

      // Encrypted API key lives here — fully denied to all clients.
      // Only the backend (Admin SDK) can read/write it.
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Generations: owner + admin can read. Writes happen via backend only.
      match /generations/{genId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }
  }
}
