rules_version = '2';

// FeasibilityAI Firestore security rules.
// Principles:
//  - A user reads only their own user doc, analyses and reports.
//  - Clients can NEVER create analyses, set their own status/role/credits, or
//    read anyone's stored API key. Those are server-only (Admin SDK bypasses
//    rules) after checking approval + credits.
//  - Admin = a custom claim (request.auth.token.admin == true), set server-side.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOrgMember(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // --- users ---
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // A new signup may create ONLY their own doc, pending, as a normal user,
      // and may not grant themselves credits/role.
      allow create: if isOwner(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user'
        && request.resource.data.credits == 0;

      // Users may edit profile fields only — never status, role or credits.
      allow update: if isOwner(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.role == resource.data.role
        && request.resource.data.credits == resource.data.credits;

      // Approvals, role changes and credit grants are admin-only.
      allow update, delete: if isAdmin();

      // Encrypted BYOK keys live in a server-only subcollection — no client access.
      match /secrets/{doc} {
        allow read, write: if false; // Admin SDK only
      }
    }

    // --- usernames: username -> {uid,email}, needed pre-auth for login lookup ---
    match /usernames/{username} {
      allow get: if true;   // resolve username -> email before sign-in
      allow list: if false; // no enumeration
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow update, delete: if false; // immutable from the client (Admin SDK can override)
    }

    // --- analyses (created + written by the server worker only) ---
    match /analyses/{analysisId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid) ||
        (signedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId));
      allow create, update, delete: if false; // server (Admin SDK) only

      match /stageOutputs/{stage} {
        allow read: if isAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/analyses/$(analysisId)).data.uid == request.auth.uid);
        allow write: if false;
      }

      // Named stress-test scenarios — owner/admin read, server-only write.
      match /scenarios/{scenarioId} {
        allow read: if isAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/analyses/$(analysisId)).data.uid == request.auth.uid);
        allow write: if false; // server (Admin SDK) only, via /api/scenarios
      }
    }

    // --- organizations: multi-tenant workspace layer, additive on top of the
    // per-user model above. Owner manages branding/keys server-side; any
    // member can read the org doc and the member roster.
    match /organizations/{orgId} {
      allow read: if isAdmin() || isOrgMember(orgId);
      allow write: if false; // server only, via /api/org routes

      match /members/{uid} {
        allow read: if isAdmin() || isOrgMember(orgId);
        allow write: if false; // server only
      }

      // API key metadata (never the raw secret) — owner-only, server-written.
      match /apiKeys/{keyId} {
        allow read: if isAdmin() || isOrgMember(orgId);
        allow write: if false; // server only, via /api/org/keys
      }
    }

    // --- reports ---
    match /reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // server only
    }

    // --- usage ledger (read own, server writes) ---
    match /usage/{uid}/{document=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // --- payment history (Stripe webhook writes; owner + admin read) ---
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // server only, via the Stripe webhook
    }

    // --- admin audit log — admin-only read, server-only write ---
    match /auditLog/{entry} {
      allow read: if isAdmin();
      allow write: if false; // server only, via lib/firebase/audit.ts
    }

    // --- raw LLM prompt/completion pairs, captured for a future fine-tune —
    // admin-only read (this is training data, not user-facing), server-only write.
    match /trainingData/{entry} {
      allow read: if isAdmin();
      allow write: if false; // server only, via lib/engine/trainingLog.ts
    }
  }
}
