# ==========================================================================
# Lumina Studio — environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ==========================================================================

# --- Frontend (Firebase Web SDK — safe to expose, injected by Vite) --------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Analytics & Crash Reporting (frontend, safe to expose) ---------------
# PostHog: product analytics + feature flags. Leave blank to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry: crash/error reporting. Leave blank to disable.
VITE_SENTRY_DSN=
# Label shown on events (e.g. "production", "staging"). Defaults to Vite's mode.
VITE_APP_ENV=

# --- Backend (Express API / Cloud Run) ------------------------------------
# Master secret used to AES-256-GCM encrypt each user's Gemini key at rest.
# Use a long random string (e.g. `openssl rand -base64 48`). KEEP SECRET.
KEY_ENCRYPTION_SECRET=

# Email that is auto-provisioned as the first active admin on signup.
SUPER_ADMIN_EMAIL=thatboitrippinofficial@gmail.com

# Storage bucket the Admin SDK writes generated images to.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Credentials for firebase-admin:
#  - Local dev: paste the full service-account JSON as a single line here,
#    OR set GOOGLE_APPLICATION_CREDENTIALS to a JSON file path.
#  - Cloud Run: leave BOTH unset — Application Default Credentials are used.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cloud Run sets PORT automatically; defaults to 3000 locally.
# PORT=3000

# Sentry crash reporting for the Express API. Leave blank to disable.
SENTRY_DSN=
