# Copy to .env.local and fill in. NEVER commit real values.

# --- LLM engine (platform key; users may override with BYOK later) ---
OPENAI_API_KEY=
# Model used for all analysis + report steps. Standardize on one current model.
FEASIBILITY_MODEL=gpt-4o
# Cheaper model for the light extraction/follow-up step.
FEASIBILITY_EXTRACT_MODEL=gpt-4o-mini

# --- Web search (rotate the leaked SerpAPI key before using) ---
SERPAPI_API_KEY=
# Max search queries a single specialist may run (cost cap).
FEASIBILITY_MAX_SEARCHES_PER_STAGE=4

# --- Engine mode ---
# When true, no external APIs are called — deterministic fixtures are returned.
# Lets the whole pipeline run + be tested with zero keys and zero cost.
FEASIBILITY_MOCK=false
