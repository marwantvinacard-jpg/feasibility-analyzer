# Copy to .env.local and fill in. NEVER commit real values.

# =========================================================================
#  AI PROVIDER
#  Leave everything blank to run in MOCK mode (zero keys, zero cost).
#  To go live, either set FEASIBILITY_PROVIDER explicitly, or just drop in a
#  key below — the engine auto-detects it. All hosted options are OpenAI-API
#  compatible, so switching is a one-line change.
# =========================================================================

# mock | openai | gemini | groq | cerebras | ollama   (optional; auto-detects if unset)
FEASIBILITY_PROVIDER=

# Override the model for whichever provider is active (optional).
FEASIBILITY_MODEL=
# Cheaper model for the light extraction/pre-fill step (optional).
FEASIBILITY_EXTRACT_MODEL=

# --- Premium / BYOK: OpenAI (ChatGPT) ---
OPENAI_API_KEY=

# --- FREE hosted tier: Google Gemini 2.5 Flash (no card) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- FREE hosted tier: Groq (fast) / Cerebras ---
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- FREE local: Ollama (no key; runs on your machine) ---
# Install from https://ollama.com, then: ollama pull qwen3
# Set FEASIBILITY_PROVIDER=ollama and (optionally) a host below.
OLLAMA_HOST=

# Force mock even if a key is present (useful for demos).
FEASIBILITY_MOCK=
# Artificial per-call delay (ms) for the mock provider, so the web UI shows
# believable live progress. Ignored by real providers.
FEASIBILITY_MOCK_DELAY_MS=

# =========================================================================
#  WEB SEARCH  (used by the research-heavy specialists; optional)
#  Recommended low-dependency path: self-hosted SearXNG (OSS, no key).
#  Rotate the SerpAPI key that leaked in the original n8n workflow.
# =========================================================================
SERPAPI_API_KEY=
FEASIBILITY_MAX_SEARCHES_PER_STAGE=4

# =========================================================================
#  FIREBASE  (leave blank until you create the project — see FIREBASE_SETUP.md)
#  With these unset, the app stays on the local (localStorage) stubs.
#  Paste the "Web app" config from the Firebase console here.
# =========================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only (Admin SDK) — for the worker that creates analyses & sets claims.
# Paste the service-account JSON as a single line, or use a path.
FIREBASE_SERVICE_ACCOUNT_JSON=

# =========================================================================
#  STRIPE  (wallet top-ups + Pro subscription; leave blank to disable billing)
# =========================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Org plan prices — run scripts/setup-stripe-org-plans.mjs to create both the
# monthly and annual (2 months free) Price for each of the 3 tiers.
STRIPE_ORG_STARTER_PRICE_ID=
STRIPE_ORG_STARTER_ANNUAL_PRICE_ID=
STRIPE_ORG_GROWTH_PRICE_ID=
STRIPE_ORG_GROWTH_ANNUAL_PRICE_ID=
STRIPE_ORG_ENTERPRISE_PRICE_ID=
STRIPE_ORG_ENTERPRISE_ANNUAL_PRICE_ID=

# =========================================================================
#  EMAIL  (approval + "report ready" transactional emails; leave blank to
#  disable — the app runs fine without it, users just won't get notified)
#  Get a key at resend.com; verify a sending domain before going live,
#  otherwise use the onboarding@resend.dev sandbox address for EMAIL_FROM.
# =========================================================================
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=
