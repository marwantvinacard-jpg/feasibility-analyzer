{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "noEmit": false,
    "outDir": ".test-build",
    "isolatedModules": false,
    "declaration": false,
    "jsx": "react-jsx",
    "incremental": false
  },
  "include": [
    "lib/engine/types.ts",
    "lib/engine/financial.ts",
    "lib/engine/scorer.ts",
    "lib/engine/risk.ts",
    "lib/engine/projections.ts",
    "lib/engine/financialModel.ts",
    "lib/pricing.ts",
    "lib/currencies.ts",
    "lib/exportAccess.ts",
    "lib/orgTypes.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-build"]
}
